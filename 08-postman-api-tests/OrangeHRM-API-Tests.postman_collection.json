            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v2/directory/employees",
            "description": "Expected 401 is a provisional API security expectation; some implementations return 403 or redirects. Record evidence and compare with approved API contract.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
