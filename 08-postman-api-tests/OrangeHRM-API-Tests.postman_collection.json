    {
      "name": "03 \u2014 Negative Read-Only Tests",
      "description": "Strict expected statuses are working hypotheses until verified in your deployed version. Prefer isolated/sandbox deployment.",
      "item": [
        {
          "name": "API-TC-004 Directory without access token",
          "request": {
